case $- in *i*) ;; *) return 0 2>/dev/null || exit 0;; esac

__gascan_starship_warn()
{
    if [ "${__gascan_starship_warning_shown:-0}" != 1 ]; then
        printf '%s\n' 'gascan: Starship prompt unavailable; using standard Bash prompt.' >&2
        __gascan_starship_warning_shown=1
    fi
    return 0
}

__gascan_shell_metadata()
{
    local metadata
    metadata=$(/usr/bin/stat -c '%u:%g:%a:%h' -- "$1" 2>/dev/null)
    case "$metadata" in
        *:*:*:*)
            ;;
        *)
            metadata=$(/usr/bin/stat -f '%u:%g:%Lp:%l' "$1" 2>/dev/null)
            ;;
    esac
    printf '%s\n' "$metadata"
}

__gascan_starship_restore()
{
    PS1=$__gascan_starship_old_ps1
    PATH=$__gascan_starship_old_path
    export PATH
    if [ "$__gascan_starship_config_was_set" = 1 ]; then
        STARSHIP_CONFIG=$__gascan_starship_old_config
        export STARSHIP_CONFIG
    else
        unset STARSHIP_CONFIG
    fi
    if [ "$__gascan_starship_executable_was_set" = 1 ]; then
        STARSHIP_EXECUTABLE=$__gascan_starship_old_executable
        export STARSHIP_EXECUTABLE
    else
        unset STARSHIP_EXECUTABLE
    fi
}

__gascan_starship_emit_variable()
{
    local declaration attributes
    if declaration=$(declare -p "$1" 2>/dev/null); then
        attributes=${declaration#declare -}
        attributes=${attributes%% *}
        case "$attributes" in
            *r*) return 0 ;;
        esac
        declaration=${declaration#declare }
        declaration=${declaration#* }
        printf '%s\n' "$declaration"
    else
        printf 'unset %q\n' "$1"
    fi
}

__gascan_starship_build_commit()
{
    local initialization=$1 inherited_debug_trap=$2 name
    local -a commit_functions=(
        _starship_set_return starship_preexec starship_precmd
        starship_preexec_all starship_preexec_ps0
    )
    local -a commit_variables=(
        PS0 PS1 PS2 PROMPT_COMMAND preexec_functions precmd_functions
        STARSHIP_CONFIG STARSHIP_EXECUTABLE STARSHIP_PREEXEC_READY
        STARSHIP_START_TIME STARSHIP_PROMPT_COMMAND STARSHIP_DEBUG_TRAP
        STARSHIP_SHELL STARSHIP_SESSION_KEY
    )

    # The immutable full init executes exactly once and only in this inherited
    # subshell. A nonzero result cannot mutate the interactive parent shell.
    if [ -n "$inherited_debug_trap" ]; then
        eval "$inherited_debug_trap"
    fi
    if ! eval "$initialization" >/dev/null 2>&1; then
        return 1
    fi

    for name in "${commit_functions[@]}"; do
        if declare -F "$name" >/dev/null; then
            declare -f "$name"
        else
            printf 'unset -f %q\n' "$name"
        fi
    done
    for name in "${commit_variables[@]}"; do
        __gascan_starship_emit_variable "$name"
    done
    shopt -p checkwinsize
    if ! trap -p DEBUG; then
        printf '%s\n' 'trap - DEBUG'
    elif [ -z "$(trap -p DEBUG)" ]; then
        printf '%s\n' 'trap - DEBUG'
    fi
}

__gascan_starship_main()
{
    local selector=/home/workspace/.config/gascan/shell/prompt
    local config=/home/workspace/.config/gascan/shell/starship.toml
    local binary=/opt/gascan/shell/bin/starship
    local binary_target=/opt/gascan/workstation/bin/starship
    local binary_link=../../workstation/bin/starship
    local immutable_path=/opt/gascan/shell/bin:/usr/bin:/bin
    local managed_owner=0 workspace_uid=1000 workspace_gid=1000
    local immutable_owner=0 immutable_gid=0 immutable_link_mode=777
    local prompt preset selected_config initialization commit debug_trap
    local selector_metadata config_metadata preset_metadata
    local binary_metadata binary_target_metadata

    selector_metadata=$(__gascan_shell_metadata "$selector")
    if [ ! -f "$selector" ] || [ -L "$selector" ] ||
        [ "$selector_metadata" != "$managed_owner:$workspace_gid:640:1" ]; then
        __gascan_starship_warn
        return 0
    fi
    if /usr/bin/cmp -s "$selector" <(/usr/bin/printf '%s\n' standard); then
        return 0
    elif /usr/bin/cmp -s "$selector" <(/usr/bin/printf '%s\n' starship); then
        prompt=starship
        preset=/opt/gascan/shell/presets/starship.toml
    elif /usr/bin/cmp -s "$selector" \
        <(/usr/bin/printf '%s\n' starship-nerd-font); then
        prompt=starship-nerd-font
        preset=/opt/gascan/shell/presets/starship-nerd-font.toml
    else
        __gascan_starship_warn
        return 0
    fi

    __gascan_starship_euid=$(/usr/bin/id -u)
    case "$__gascan_starship_euid" in
        0)
            selected_config=$preset
            ;;
        "$workspace_uid")
            selected_config=$config
            ;;
        *)
            __gascan_starship_warn
            return 0
            ;;
    esac
    if [ -n "${BLE_VERSION-}" ]; then
        __gascan_starship_warn
        return 0
    fi

    config_metadata=$(__gascan_shell_metadata "$config")
    preset_metadata=$(__gascan_shell_metadata "$preset")
    binary_metadata=$(__gascan_shell_metadata "$binary")
    binary_target_metadata=$(__gascan_shell_metadata "$binary_target")
    if [ ! -f "$config" ] || [ -L "$config" ] ||
        [ "$config_metadata" != "$managed_owner:$workspace_gid:640:1" ] ||
        [ ! -f "$preset" ] || [ -L "$preset" ] ||
        [ "$preset_metadata" != "$immutable_owner:$immutable_gid:444:1" ] ||
        [ ! -L "$binary" ] ||
        [ "$binary_metadata" != \
            "$immutable_owner:$immutable_gid:$immutable_link_mode:1" ] ||
        [ "$(/usr/bin/readlink "$binary" 2>/dev/null)" != "$binary_link" ] ||
        [ ! -f "$binary_target" ] || [ -L "$binary_target" ] ||
        [ "$binary_target_metadata" != "$immutable_owner:$immutable_gid:555:1" ] ||
        ! /usr/bin/cmp -s "$config" "$preset"; then
        __gascan_starship_warn
        return 0
    fi

    __gascan_starship_old_ps1=${PS1-}
    __gascan_starship_old_path=$PATH
    if [ "${STARSHIP_CONFIG+x}" = x ]; then
        __gascan_starship_config_was_set=1
        __gascan_starship_old_config=$STARSHIP_CONFIG
    else
        __gascan_starship_config_was_set=0
        __gascan_starship_old_config=
    fi
    if [ "${STARSHIP_EXECUTABLE+x}" = x ]; then
        __gascan_starship_executable_was_set=1
        __gascan_starship_old_executable=$STARSHIP_EXECUTABLE
    else
        __gascan_starship_executable_was_set=0
        __gascan_starship_old_executable=
    fi

    STARSHIP_CONFIG=$selected_config
    STARSHIP_EXECUTABLE=$binary
    PATH=$immutable_path
    export STARSHIP_CONFIG STARSHIP_EXECUTABLE PATH
    if ! initialization=$("$binary" init bash --print-full-init); then
        __gascan_starship_restore
        __gascan_starship_warn
        return 0
    fi
    debug_trap=$(trap -p DEBUG)
    if ! commit=$(
        __gascan_starship_build_commit "$initialization" "$debug_trap"
    ); then
        __gascan_starship_restore
        __gascan_starship_warn
        return 0
    fi
    if ! /bin/bash -n <<<"$commit" >/dev/null 2>&1; then
        __gascan_starship_restore
        __gascan_starship_warn
        return 0
    fi
    trap - DEBUG
    if ! eval "$commit"; then
        if [ -n "$debug_trap" ]; then
            eval "$debug_trap"
        fi
        __gascan_starship_restore
        __gascan_starship_warn
        return 0
    fi
    export STARSHIP_CONFIG STARSHIP_EXECUTABLE
    if [ "${STARSHIP_SHELL+x}" = x ]; then
        export STARSHIP_SHELL
    fi
    if [ "${STARSHIP_SESSION_KEY+x}" = x ]; then
        export STARSHIP_SESSION_KEY
    fi
    PATH=$__gascan_starship_old_path
    export PATH
    unset __gascan_starship_old_ps1 __gascan_starship_old_path \
        __gascan_starship_config_was_set __gascan_starship_old_config \
        __gascan_starship_executable_was_set __gascan_starship_old_executable \
        __gascan_starship_euid
    return 0
}

__gascan_starship_main
unset -f __gascan_starship_main __gascan_starship_restore \
    __gascan_starship_build_commit __gascan_starship_emit_variable \
    __gascan_starship_warn __gascan_shell_metadata
return 0 2>/dev/null || exit 0
